root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official
# Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.kts]
# Version catalog accessors are long dotted chains (libs.versions.x.get().toInt()); keep them on one line.
ktlint_chain_method_rule_force_multiline_when_chain_operator_count_greater_or_equal_than = 6

[*.{toml,xml,properties}]
indent_style = space
indent_size = 4
