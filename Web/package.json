{
  "name": "bananachess-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fixtures": "cd ../Engine && swift run ConformanceFixtures ../Web/fixtures/conformance.json && gzip -9 -f ../Web/fixtures/conformance.json",
    "deploy": "npm run build && wrangler deploy",
    "serve": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.147.0"
  }
}
